# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL Connection
# Direct connection string or transaction pooler for Drizzle ORM
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL=

# Supabase Project Credentials
# Found under Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Optional for V1 - App functions without it)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Meta / Instagram (Optional for V1 - Reserved for V5)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/instagram

# Token Encryption Secret (32-character key for encrypting stored tokens in future versions)
TOKEN_ENCRYPTION_KEY=
